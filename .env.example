# Copiez ce fichier vers .env et ne publiez jamais le fichier .env.
# Backend Spring Boot utilise par le travailleur de simulation.
SPRING_BOOT_URL=http://localhost:8080
# Secret serveur-a-serveur : doit correspondre a la valeur configuree dans Spring Boot.
AI_API_KEY=dev-ai-api-key-change-me
# "local" permet au RAG de fonctionner sans cle et sans cout d'API.
EMBEDDING_PROVIDER=local
# Gemini : fournisseur recommande pour les recommandations de simulation.
GEMINI_API_KEY=
GEMINI_SIMULATION_MODEL=gemini-3.5-flash-lite
# Optionnel : OpenAI est utilise seulement avec EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
# Port du service RAG local.
PORT=8001
# Le worker récupère automatiquement les simulations EN_ATTENTE.
SIMULATION_WORKER_ENABLED=true
SIMULATION_POLL_INTERVAL_SECONDS=20
